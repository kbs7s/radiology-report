rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isRadiologist() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'radiologist';
    }

    // User profiles {name, role} are created by hand in the console
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /reports/{id} {
      allow read: if signedIn();
      // Reception (or anyone signed in) registers a patient: status registered or draft
      allow create: if signedIn()
        && request.resource.data.status in ['registered', 'draft']
        && request.resource.data.createdBy == request.auth.uid;
      // Any signed-in user may edit a record that is not approved; only the radiologist
      // may approve, edit an approved report, or re-open it
      allow update: if signedIn() && (
        isRadiologist() ||
        (resource.data.status != 'approved' && request.resource.data.status != 'approved')
      );
      allow delete: if isRadiologist();
    }

    // Report library chunks: read by everyone signed in, uploaded by the radiologist
    match /library/{doc} {
      allow read: if signedIn();
      allow write: if isRadiologist();
    }

    // Shared dictionary of words marked as correct
    match /settings/{doc} {
      allow read, write: if signedIn();
    }
  }
}
